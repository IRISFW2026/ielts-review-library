        "all",
        [
          "match",
          [
            "get",
            "class"
          ],
          [
            "country"
          ],
          true,
          false
        ],
        [
          "<=",
          [
            "coalesce",
            [
              "get",
              "rank"
            ],
            0
          ],
          2
        ]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
