      "source": "openmaptiles",
      "source-layer": "boundary",
      "paint": {
        "line-color": "#c4c9d0",
        "line-width": 0.65,
        "line-dasharray": [
          3,
          3
        ]
      },
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "admin_level"
          ],
          4
        ],
        [
          "!=",
          [
            "get",
            "maritime"
          ],
          1
        ]
      ],
      "minzoom": 6
    },
    {
      "id": "country-borders",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "paint": {
        "line-color": "#b9c1cc",
        "line-width": 1,
        "line-dasharray": [
          3,
          2
        ]
      },
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "admin_level"
          ],
          2
        ],
        [
          "!=",
          [
            "get",
            "maritime"
