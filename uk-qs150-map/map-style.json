    {
      "id": "natural-areas",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "class"
          ],
          [
            "wood"
          ],
          "#dfead9",
          [
            "grass"
          ],
          "#e7eddf",
          [
            "farmland"
          ],
          "#edf0e7",
          [
            "ice"
          ],
          "#f7fbfd",
          "#f1f3f4"
        ],
        "fill-opacity": 0.85
      }
    },
    {
      "id": "parks",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "class"
          ],
          [
            "park",
            "recreation_ground",
            "village_green",
            "cemetery"
          ],
          "#e1ecd9",
          [
            "residential"
          ],
          "#f4f5f6",
          [
            "industrial",
            "commercial"
          ],
          "#ebedf0",
          "#f1f3f4"
        ],
        "fill-opacity": 0.8
      }
    },
    {
      "id": "park-areas",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#deead7",
        "fill-opacity": 0.65
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#c8dcf4",
        "fill-antialias": true
      }
    },
    {
      "id": "rivers",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#c0d8f2",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.4,
          12,
          1.2,
          16,
          3.2
        ]
      },
      "minzoom": 8
